[
  {
    "bookSourceName": "笔趣阁HK",
    "bookSourceUrl": "http://www.biquge.hk",
    "bookSourceGroup": "默认",
    "bookSourceComment": "笔趣阁HK站源，支持小说搜索和阅读",
    "bookSourceType": 0,
    "enabled": true,
    "enabledCookieJar": true,
    "enabledExplore": true,
    "enabledReview": false,
    "header": "",
    "searchUrl": "http://www.biquge.hk/search/result.html?searchkey={{key}}",
    "exploreUrl": "http://www.biquge.hk/category.html",
    "bookUrlPattern": "",
    "weight": 100,
    "customOrder": 2,
    "ruleSearch": {
      "bookList": "div.item",
      "name": "dt a@text",
      "author": "dd a@text",
      "bookUrl": "dt a@href",
      "coverUrl": "img@src",
      "intro": "dd.intro@text",
      "lastChapter": "",
      "kind": ""
    },
    "ruleExplore": {
      "bookList": "div.item",
      "name": "dt a@text",
      "author": "dd a@text",
      "bookUrl": "dt a@href",
      "coverUrl": "img@src",
      "intro": "dd.intro@text"
    },
    "ruleBookInfo": {
      "name": "meta[property='og:novel:book_name']@content",
      "author": "meta[property='og:novel:author']@content",
      "coverUrl": "meta[property='og:image']@content",
      "intro": "meta[property='og:description']@content",
      "kind": "meta[property='og:novel:category']@content",
      "lastChapter": "meta[property='og:novel:latest_chapter_name']@content",
      "updateTime": "meta[property='og:novel:update_time']@content",
      "status": "meta[property='og:novel:status']@content",
      "tocUrl": ""
    },
    "ruleToc": {
      "chapterList": ".dirlist li",
      "chapterName": "a@title",
      "chapterUrl": "a@href"
    },
    "ruleContent": {
      "content": "#content@html",
      "replaceRegex": ".*笔趣阁.*|.*biquge.hk.*|.*最新章节.*|.*请收藏.*|.*提示.*|.*\\(快捷键：←→\\).*"
    },
    "ruleReview": {}
  }
]