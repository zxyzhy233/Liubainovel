      return -1;
    }
    const valueBucket: relationalStore.ValuesBucket = {
      bookName: book.bookName,
      author: book.author,
      filePath: book.filePath,
      coverPath: book.coverPath,
      progress: book.progress,
      lastReadTime: book.lastReadTime
    };
    try {
