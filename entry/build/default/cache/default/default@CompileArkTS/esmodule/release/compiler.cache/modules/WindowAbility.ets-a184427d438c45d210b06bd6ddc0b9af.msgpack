import window from "@ohos.window";
import deviceInfo from "@ohos.deviceInfo";
import display from "@ohos.display";
import hilog from "@ohos.hilog";
const TAG = 'WindowAbility';
export class WindowAbility {
    constructor() {
        this.context = null;
        this.windowStage = null;
        this.windowClass = null;
        this.windowType = null;
    }
    static getInstance() {
        return WindowAbility.INSTANCE;
    }
    initContext(context) {
        this.context = context;
    }
    setWindowStage(windowStage) {
        this.windowStage = windowStage;
    }
    getWindowStage() {
        return this.windowStage;
    }
    /**
     * Initialize avoid area parameters
     * @param - mainWindow windows
     * @returns void
     */
    async initAvoidArea(mainWindow) {
        hilog.info(0x0000, TAG, 'initAvoidArea start');
        // Initialize default values
        AppStorage.setOrCreate('statusBarHeight', 36);
        AppStorage.setOrCreate('navigationAiBarHeight', 28);
        const defaultDisplay = display.getDefaultDisplaySync();
        let scaledDensity = (defaultDisplay.scaledDensity > 0) ? defaultDisplay.scaledDensity : 1;
        const systemArea = mainWindow.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
        const navArea = mainWindow.getWindowAvoidArea(window.AvoidAreaType.TYPE_NAVIGATION_INDICATOR);
        if (systemArea) {
            const statusBarHeight = systemArea.topRect.height / scaledDensity;
            hilog.info(0x0000, TAG, "initAvoidArea statusBarHeight: " + statusBarHeight);
            AppStorage.setOrCreate('statusBarHeight', statusBarHeight);
            if (deviceInfo.deviceType === 'tablet') {
                AppStorage.setOrCreate("Paf.TopHeight", 56);
            }
            else if (deviceInfo.deviceType === '2in1') {
                AppStorage.setOrCreate("Paf.TopHeight", 0);
            }
            else {
                AppStorage.setOrCreate("Paf.TopHeight", systemArea.topRect.height);
            }
        }
        if (navArea) {
            const navigationAiBarHeight = navArea.bottomRect.height / scaledDensity;
            hilog.info(0x0000, TAG, "initAvoidArea navigationAiBarHeight: " + navigationAiBarHeight);
            AppStorage.setOrCreate('navigationAiBarHeight', navigationAiBarHeight);
            if (deviceInfo.deviceType === 'tablet') {
                AppStorage.setOrCreate("NavigationBarHeight", navArea.bottomRect.height);
            }
            else if (deviceInfo.deviceType === '2in1') {
                AppStorage.setOrCreate("NavigationBarHeight", 0);
            }
            else {
                AppStorage.setOrCreate("NavigationBarHeight", navArea.bottomRect.height);
            }
        }
        hilog.info(0x0000, TAG, 'initAvoidArea end');
    }
    initWindowSize() {
        window.getLastWindow(this.context, (err, windowClass) => {
            if (err.code) {
                hilog.error(0x0000, TAG, 'setWindowWidth getLastWindow failed, error is: ' + JSON.stringify(err));
                return;
            }
            let windowProperty = windowClass.getWindowProperties();
            AppStorage.setOrCreate('windowWidth', windowProperty.windowRect.width);
            AppStorage.setOrCreate('windowHeight', windowProperty.windowRect.height);
            this.windowClass = windowClass;
            this.onWindowSizeChange();
            this.onWindowStatusChange();
            this.onWindowRectChange();
        });
    }
    onWindowStatusChange() {
        if (!this.windowClass) {
            return;
        }
        this.windowClass.on('windowStatusChange', (type) => {
            this.windowType = type;
            hilog.info(0x0000, TAG, 'onWindowStatusChange type: ', JSON.stringify(type));
            this.initAvoidArea(this.windowClass);
            if (type === window.WindowStatusType.FLOATING) {
                AppStorage.setOrCreate("NavigationBarHeight", 0);
            }
        });
    }
    onWindowRectChange() {
        if (!this.windowClass) {
            return;
        }
        this.windowClass.on('windowRectChange', (option) => {
            if (this.windowType === window.WindowStatusType.SPLIT_SCREEN ||
                this.windowType === window.WindowStatusType.FULL_SCREEN) {
                // Reacquire the navigation bar height
                this.setNavigationBar();
            }
        });
    }
    setNavigationBar() {
        if (!this.windowClass) {
            return;
        }
        const nav = this.windowClass.getWindowAvoidArea(window.AvoidAreaType.TYPE_NAVIGATION_INDICATOR);
        hilog.info(0x0000, TAG, 'setNavigationBar avoidArea: ', JSON.stringify(nav));
        if (nav) {
            AppStorage.setOrCreate("NavigationBarHeight", nav.bottomRect.height);
        }
    }
    async setWindowLayoutFullScreen(isFullScreen) {
        if (deviceInfo.deviceType === '2in1') {
            return;
        }
        window.getLastWindow(this.context).then(async (wnd) => {
            await wnd.setWindowLayoutFullScreen(isFullScreen);
        });
    }
    onWindowSizeChange(callback) {
        if (!this.windowClass) {
            return;
        }
        try {
            this.windowClass.on('windowSizeChange', (size) => {
                hilog.info(0x0000, TAG, 'onWindowSizeChange windowSizeChange size is: ' + JSON.stringify(size));
                AppStorage.setOrCreate('windowWidth', size.width);
                AppStorage.setOrCreate('windowHeight', size.height);
                callback && callback();
            });
        }
        catch (exception) {
            hilog.error(0x0000, TAG, 'onWindowSizeChange failed, error is ' + JSON.stringify(exception));
        }
    }
    setOrientation(windowStage, orientation) {
        windowStage.getMainWindow().then((win) => {
            win.setPreferredOrientation(orientation).then((data) => {
                hilog.info(0x0000, TAG, 'setOrientation succeeded, error is: ' + JSON.stringify(data));
            }).catch((err) => {
                hilog.error(0x0000, TAG, 'setOrientation setPreferredOrientation failed. error is: ' + JSON.stringify(err));
            });
        }).catch((err) => {
            hilog.error(0x0000, TAG, 'setOrientation getMainWindow failed, error is ' + JSON.stringify(err));
        });
    }
    /**
     * Set the system bar to have visible.
     *
     * @param { Array<'status' | 'navigation'> } names - The set of system bar
     * @param context - Current application context
     */
    toggleWindowSystemBar(names, windowContext) {
        window.getLastWindow(windowContext, (err, data) => {
            try {
                if (err.code) {
                    return;
                }
                let windowClass = data;
                if (names.length === 0) {
                    AppStorage.setOrCreate('Grid.tabPro.enableAvoidAreaListener', false);
                }
                windowClass.setWindowSystemBarEnable(names).then(() => {
                    hilog.info(0x0000, TAG, 'toggleWindowSystemBar setWindowSystemBarEnable succeeded');
                }, (error) => {
                    if (error) {
                        hilog.error(0x0000, TAG, 'toggleWindowSystemBar setWindowSystemBarEnable failed, error is:' + JSON.stringify(error));
                    }
                });
                if (names.length > 0) {
                    AppStorage.setOrCreate('Grid.tabPro.enableAvoidAreaListener', true);
                }
                hilog.info(0x0000, TAG, 'toggleWindowSystemBar Succeeded in setting the system bar to be invisible.');
            }
            catch (exception) {
                hilog.error(0x0000, TAG, 'toggleWindowSystemBar Failed to set the system bar to be invisible. Cause:' + JSON.stringify(exception));
            }
        });
    }
}
WindowAbility.INSTANCE = new WindowAbility();
//# sourceMappingURL=WindowAbility.js.mapÂ”Ùf␀hvigor_ignore_D:_Program Files_Huawei_DevEco Studio_sdk_default_openharmony_ets_api_@ohos.window.d.tsÙj␀hvigor_ignore_D:_Program Files_Huawei_DevEco Studio_sdk_default_openharmony_ets_api_@ohos.deviceInfo.d.tsÙg␀hvigor_ignore_D:_Program Files_Huawei_DevEco Studio_sdk_default_openharmony_ets_api_@ohos.display.d.tsÙe␀hvigor_ignore_D:_Program Files_Huawei_DevEco Studio_sdk_default_openharmony_ets_api_@ohos.hilog.d.tsÙED:\ST\ReaderKitDemo\entry\src\main\ets\entryability\WindowAbility.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¯hostModulesInfo¬shouldEmitJs¥entryÃÂ¹D:\ST\ReaderKitDemo\entry³D:\ST\ReaderKitDemo¥entry¥1.0.0Ô␀␀¹D:\ST\ReaderKitDemo\entry“ÔrC’²hostDependencyName®hostModuleName¯./WindowAbility¥entryC½../entryability/WindowAbility¥entryC½../entryability/WindowAbility¥entryÃÃÚ!¥/*
