import { Index } from './Index';
import { MinePage } from './Mine';
import { RecommendPage } from './RecommendPage';

@Entry
@Component
struct MainPage {
  @State currentIndex: number = 0;

  @Builder TabBuilder(title: string, targetIndex: number, icon: Resource) {
    Column() {
      Image(icon)
        .width(24)
        .height(24)
        .fillColor(this.currentIndex === targetIndex ? '#243154' : $r('app.color.black_60_opacity'))
      Text(title)
        .fontColor(this.currentIndex === targetIndex ? '#243154' : $r('app.color.black_60_opacity'))
        .fontSize(12)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
  }

  build() {
    Tabs({ barPosition: BarPosition.End }) {
      TabContent() {
        Index()
      }
      .tabBar(this.TabBuilder('ä¹¦æ¶', 0, $r('app.media.bookshelf')))

      TabContent() {
        RecommendPage()
      }
      .tabBar(this.TabBuilder('æ¨è', 1, $r('app.media.faxian')))

      TabContent() {
        MinePage()
      }
      .tabBar(this.TabBuilder('æˆ‘çš„', 2, $r('app.media.usercenter')))
    }
    .onChange((index: number) => {
      this.currentIndex = index;
    })
    .width('100%')
    .height('100%')
  }
}
