  /**
   * æ„å»ºå¼¹å‡ºèœå•
   */
  @Builder
  private popupWithButtonBuilder() {
    Column() {
      Row() {
        Image($r("app.media.Plus")).width(20).height(20)
        Text('æ–°å»ºä¹¦æº').fontSize(18)
      }
      .height(this.getMenuItemHeight())
      .width('100%')
      .justifyContent(FlexAlign.Start)
      .alignItems(VerticalAlign.Center)
