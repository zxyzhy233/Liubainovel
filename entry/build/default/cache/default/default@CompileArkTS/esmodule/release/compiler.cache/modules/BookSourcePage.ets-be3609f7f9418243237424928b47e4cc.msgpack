            hilog.error(0x0000, TAG, 'å¯¼å…¥ä¹¦æºå¤±è´¥: ' + JSON.stringify(error));
            const errorToastOptions = {
                message: 'å¯¼å…¥ä¹¦æºå¤±è´¥',
                duration: 2000
            };
            this.getUIContext()
