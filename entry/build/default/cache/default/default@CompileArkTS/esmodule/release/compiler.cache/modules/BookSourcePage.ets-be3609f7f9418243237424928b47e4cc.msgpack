  /**
   * æ„å»ºé¡¶éƒ¨å¯¼èˆªæ 
   */
  @Builder
  private buildHeader(): void {
    Row() {
      // è¿”å›æŒ‰é’®
      Button() {
        Text('â€¹')
          .fontSize(24)
          .fontColor('#2D3748')
          .fontWeight(FontWeight.Bold)
      }
      .width(this.getButtonSize())
      .height(this.getButtonSize())
      .backgroundColor(Color.Transparent)
      .onClick(() => {
        this.goBack();
      })
      
      // æ ‡é¢˜
      Text('ä¹¦æºç®¡ç†')
        .fontSize(20)
        .fontWeight(FontWeight.Bold)
        .fontColor('#2D3748')
        .layoutWeight(1)
        .textAlign(TextAlign.Center)
      
      // æ·»åŠ æŒ‰é’®
      Button() {
        Text('+')
          .fontSize(24)
          .fontColor('#2D3748')
          .fontWeight(FontWeight.Bold)
      }
      .width(this.getButtonSize())
      .height(this.getButtonSize())
      .backgroundColor(Color.Transparent)
      .onClick(() => {
        this.showAddMenu = !this.showAddMenu;
      })
      .bindPopup($$this.showAddMenu, this.createPopupOptions())
    }
    .width('100%')
    .height(this.getNavBarHeight())
    .padding(this.createPaddingOptions())
    .margin(this.createSpecificMarginOptions())
    .backgroundColor(Color.White)
    .shadow(this.createShadowOptions())
  }

  /**
   * æ„å»ºä¹¦æºå¡ç‰‡
   */
  @Builder
  private buildBookSourceCard(source: BookSource): void {
    Column() {
      // ä¹¦æºä¿¡æ¯è¡Œ
      Row() {
        Column() {
          // ä¹¦æºåç§°
          Text(source.name)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor('#2D3748')
            .width('100%')
            .textAlign(TextAlign.Start)
          
          // ä¹¦æºURL
          Text(source.url)
            .fontSize(12)
            .fontColor('#718096')
            .margin(this.createTextMarginOptions())
            .width('100%')
            .textAlign(TextAlign.Start)
            .maxLines(1)
            .textOverflow(this.createTextOverflowOptions())
        }
        .layoutWeight(1)
        .alignItems(HorizontalAlign.Start)
        
        // å¯ç”¨å¼€å…³
        Toggle(this.createToggleOptions(source.enabled))
          .onChange((isOn: boolean) => {
            this.toggleBookSource(source);
          })
      }
      .width('100%')
      .margin(this.createBottomMarginOptions())
      
      // æè¿°å’Œæ›´æ–°æ—¶é—´
      Row() {
        Text(source.description)
          .fontSize(12)
          .fontColor('#4A5568')
          .layoutWeight(1)
          .maxLines(1)
          .textOverflow(this.createTextOverflowOptions())
        
        Text('æ›´æ–°: ' + source.lastUpdate)
          .fontSize(10)
          .fontColor('#A0AEC0')
      }
      .width('100%')
      .margin(this.createBottomMarginOptions())
      
      // æ“ä½œæŒ‰é’®
      Row() {
        Button('æµ‹è¯•')
          .fontSize(12)
          .fontColor('#3182CE')
          .backgroundColor('#EBF8FF')
          .borderRadius(this.getButtonBorderRadius())
          .padding(this.createButtonPaddingOptions())
          .onClick(() => {
            hilog.info(0x0000, TAG, 'æµ‹è¯•ä¹¦æº: ' + source.name);
          })
        
        Button('ç¼–è¾‘')
          .fontSize(12)
          .fontColor('#38A169')
          .backgroundColor('#C6F6D5')
          .borderRadius(this.getButtonBorderRadius())
          .padding(this.createButtonPaddingOptions())
          .margin(this.createButtonMarginOptions())
          .onClick(() => {
            this.navigateToEditSource(source);
          })
        
        Blank()
        
        Button('åˆ é™¤')
          .fontSize(12)
          .fontColor('#E53E3E')
          .backgroundColor('#FED7D7')
          .borderRadius(this.getButtonBorderRadius())
          .padding(this.createButtonPaddingOptions())
          .onClick(() => {
            this.deleteBookSource(source.id);
          })
      }
      .width('100%')
    }
    .width('100%')
    .padding(this.getCardPadding())
    .backgroundColor(Color.White)
    .borderRadius(8)
    .margin(this.createCardMarginOptions())
    .shadow(this.createShadowOptions())
  }

