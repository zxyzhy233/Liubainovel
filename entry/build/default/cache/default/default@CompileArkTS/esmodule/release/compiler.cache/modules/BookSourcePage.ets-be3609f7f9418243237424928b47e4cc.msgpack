            // è¯»å–æ–‡ä»¶å†…å®¹
            let file = fileIo.openSync(srcFile, fileIo.OpenMode.READ_ONLY);
            let buffer = new ArrayBuffer(1024 * 1024); // 1MBç¼“å†²åŒº
            let readLen = fileIo.readSync(file.fd, buffer);
