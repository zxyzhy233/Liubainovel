  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆªæ 
      this.buildHeader()
      
      // ä¸»è¦å†…å®¹åŒºåŸŸ
      if (this.isLoading) {
        // åŠ è½½çŠ¶æ€
        Column() {
        Progress(this.createProgressOptions())
          .width(this.getButtonSize())
          .height(this.getButtonSize())
            .color('#3182CE')
          Text('æ­£åœ¨åŠ è½½ä¹¦æº...')
            .fontSize(14)
            .fontColor('#718096')
            .margin(this.createTopMarginOptions())
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
      } else if (this.bookSources.length === 0) {
        // ç©ºçŠ¶æ€
        Column() {
          Text('ğŸ“š')
            .fontSize(48)
            .margin(this.createTopMarginOptions())
          Text('æš‚æ— ä¹¦æº')
            .fontSize(16)
            .fontColor('#718096')
            .margin(this.createBottom16MarginOptions())
          Button('æ·»åŠ ä¹¦æº')
            .fontSize(14)
            .fontColor(Color.White)
            .backgroundColor('#3182CE')
            .borderRadius(20)
            .padding(this.createLargeButtonPaddingOptions())
            .onClick(() => {
              this.navigateToAddSource();
            })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
      } else {
        // ä¹¦æºåˆ—è¡¨
        List() {
          ForEach(this.bookSources, (source: BookSource) => {
            ListItem() {
              this.buildBookSourceCard(source)
            }
          })
        }
        .width('100%')
        .layoutWeight(1)
        .padding(this.createListPaddingOptions())
        .scrollBar(BarState.Off)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F7FAFC')
  }
