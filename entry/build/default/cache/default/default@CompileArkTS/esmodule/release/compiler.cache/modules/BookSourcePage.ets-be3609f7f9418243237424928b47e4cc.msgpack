            let importedCount = 0;
            // åˆ›å»ºç©ºè§„åˆ™å¯¹è±¡
            const emptyRule = this.createEmptyRule();
            bookSourcesData.forEach((sourceData) => {
                if (sourceData.bookSourceName && sourceData.bookSourceUrl) {
                    const newSource = this.createImportedBookSource(sourceData, emptyRule, importedCount);
                    this.bookSources.push(newSource);
                    importedCount++;
                }
            });
