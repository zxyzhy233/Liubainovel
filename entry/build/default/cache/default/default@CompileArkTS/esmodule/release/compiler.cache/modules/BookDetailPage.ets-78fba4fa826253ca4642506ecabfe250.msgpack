  /**
   * æ„å»ºä¹¦ç±ä¿¡æ¯å¡ç‰‡
   */
  @Builder
  private buildBookInfo(): void {
    if (this.bookDetail) {
      Column() {
      Row() {
        // å°é¢å›¾ç‰‡
        Image(this.bookDetail.cover)
          .width(100)
          .height(130)
          .objectFit(ImageFit.Cover)
          .borderRadius(8)
          .shadow({
            radius: 8,
            color: '#20000000',
            offsetY: 4
          })
        
        // ä¹¦ç±ä¿¡æ¯
        Column() {
          // ä¹¦å
          Text(this.bookDetail.title)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#2D3748')
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .width('100%')
            .textAlign(TextAlign.Start)
            .margin({ bottom: 8 })
          
          // ä½œè€…
          Text(`ä½œè€…ï¼š${this.bookDetail.author}`)
            .fontSize(14)
            .fontColor('#4A5568')
            .width('100%')
            .textAlign(TextAlign.Start)
            .margin({ bottom: 6 })
          
          // çŠ¶æ€
          Text(`çŠ¶æ€ï¼š${this.bookDetail.status}`)
            .fontSize(14)
            .fontColor('#4A5568')
            .width('100%')
            .textAlign(TextAlign.Start)
            .margin({ bottom: 6 })
          
          // æ›´æ–°æ—¶é—´
          Text(`æ›´æ–°ï¼š${this.bookDetail.updateTime}`)
            .fontSize(14)
            .fontColor('#4A5568')
            .width('100%')
            .textAlign(TextAlign.Start)
            .margin({ bottom: 6 })
          
          // æœ€æ–°ç« èŠ‚
          Text(`æœ€æ–°ï¼š${this.bookDetail.latestChapter}`)
            .fontSize(14)
            .fontColor('#E53E3E')
            .width('100%')
            .textAlign(TextAlign.Start)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)
        .margin({ left: 16 })
        .alignItems(HorizontalAlign.Start)
        .justifyContent(FlexAlign.SpaceBetween)
      }
      .width('100%')
      .alignItems(VerticalAlign.Top)
      
      // åˆ†ç±»å’Œå­—æ•°æ ‡ç­¾
      if (this.bookDetail.category || this.bookDetail.wordCount) {
        Row() {
          if (this.bookDetail.category) {
            Text(this.bookDetail.category)
              .fontSize(12)
              .fontColor('#3182CE')
              .backgroundColor('#BEE3F8')
              .padding({ left: 8, right: 8, top: 4, bottom: 4 })
              .borderRadius(12)
          }
          
          if (this.bookDetail.wordCount) {
            Text(this.bookDetail.wordCount)
              .fontSize(12)
              .fontColor('#38A169')
              .backgroundColor('#C6F6D5')
              .padding({ left: 8, right: 8, top: 4, bottom: 4 })
              .borderRadius(12)
              .margin({ left: this.bookDetail.category ? 8 : 0 })
          }
        }
        .width('100%')
        .justifyContent(FlexAlign.Start)
        .margin({ top: 16 })
      }
      }
      .width('100%')
      .padding(20)
      .backgroundColor('#FFFFFF')
      .borderRadius(12)
      .margin({ left: 16, right: 16, top: 2 })
      .shadow({
        radius: 4,
        color: '#10000000',
        offsetY: 2
      })
    }
  }

  /**
   * æ„å»ºåº•éƒ¨æ“ä½œæŒ‰é’®
   */
  @Builder
  private buildActionButtons(): void {
    if (this.bookDetail) {
      Row() {
        Button('å¼€å§‹é˜…è¯»')
          .fontSize(16)
          .fontColor('#FFFFFF')
          .backgroundColor('#E53E3E')
          .borderRadius(8)
          .layoutWeight(1)
