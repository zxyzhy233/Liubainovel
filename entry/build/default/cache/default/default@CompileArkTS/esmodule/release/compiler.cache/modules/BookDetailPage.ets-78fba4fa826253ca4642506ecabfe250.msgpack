  /**
   * æ„å»ºé»˜è®¤ä¹¦ç±ä¿¡æ¯ï¼ˆä½¿ç”¨ä¼ é€’çš„å‚æ•°ï¼‰
   */
  @Builder
  private buildDefaultBookInfo(): void {
    if (this.bookTitle || this.bookAuthor || this.bookCover) {
      Column() {
        Row() {
          // å°é¢å›¾ç‰‡
          Image(this.bookCover || $r('app.media.default_cover'))
            .width(100)
            .height(130)
            .objectFit(ImageFit.Cover)
            .borderRadius(8)
            .shadow({
              radius: 8,
              color: '#20000000',
              offsetY: 4
            })
          
          // ä¹¦ç±ä¿¡æ¯
          Column() {
            // ä¹¦å
            Text(this.bookTitle || 'æœªçŸ¥ä¹¦å')
              .fontSize(20)
              .fontWeight(FontWeight.Bold)
              .fontColor('#2D3748')
              .maxLines(2)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
              .width('100%')
              .textAlign(TextAlign.Start)
              .margin({ bottom: 8 })
            
            // ä½œè€…
            Text(`ä½œè€…ï¼š${this.bookAuthor || 'æœªçŸ¥ä½œè€…'}`)
              .fontSize(14)
              .fontColor('#4A5568')
              .width('100%')
              .textAlign(TextAlign.Start)
              .margin({ bottom: 6 })
            
            // çŠ¶æ€
            Text('çŠ¶æ€ï¼šæ•°æ®åŠ è½½ä¸­...')
              .fontSize(14)
              .fontColor('#4A5568')
              .width('100%')
              .textAlign(TextAlign.Start)
              .margin({ bottom: 6 })
            
            // æç¤ºä¿¡æ¯
            Text('æ­£åœ¨è·å–è¯¦ç»†ä¿¡æ¯...')
              .fontSize(14)
              .fontColor('#718096')
              .width('100%')
              .textAlign(TextAlign.Start)
          }
          .layoutWeight(1)
          .margin({ left: 16 })
          .alignItems(HorizontalAlign.Start)
          .justifyContent(FlexAlign.SpaceBetween)
        }
        .width('100%')
        .alignItems(VerticalAlign.Top)
      }
      .width('100%')
      .padding(20)
      .backgroundColor('#FFFFFF')
      .borderRadius(12)
      .margin({ left: 16, right: 16, top: 2 })
      .shadow({
        radius: 4,
        color: '#10000000',
