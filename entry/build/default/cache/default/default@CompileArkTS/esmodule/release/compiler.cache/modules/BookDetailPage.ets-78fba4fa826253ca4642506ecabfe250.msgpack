  /**
   * æ„å»ºç« èŠ‚åˆ—è¡¨å¼¹çª—
   */
  @Builder
  private buildChapterListSheet(): void {
    Column() {
      // å¼¹çª—æ ‡é¢˜ï¼ˆç§»é™¤è‡ªå®šä¹‰å…³é—­æŒ‰é’®ï¼Œä½¿ç”¨ç³»ç»Ÿé»˜è®¤çš„ï¼‰
      Row() {
        Text('ç« èŠ‚ç›®å½•')
          .fontSize(18)
          .fontWeight(FontWeight.Medium)
          .fontColor('#2D3748')
          .width('100%')
          .textAlign(TextAlign.Center)
      }
      .width('100%')
      .margin({ bottom: 16 })
      
      // ç« èŠ‚åˆ—è¡¨
      if (this.chapterList.length > 0) {
        List() {
          ForEach(this.chapterList, (chapter: ChapterInfo, index: number) => {
            ListItem() {
              Row() {
                Text(`${index + 1}.`)
                  .fontSize(14)
                  .fontColor('#718096')
                  .width(40)
                
                Text(chapter.title)
                  .fontSize(14)
                  .fontColor('#2D3748')
                  .layoutWeight(1)
                  .maxLines(1)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
              }
              .width('100%')
              .padding({ left: 12, right: 12, top: 12, bottom: 12 })
              .backgroundColor('#F7FAFC')
              .borderRadius(8)
              .margin({ bottom: 8 })
              .onClick(() => {
                this.openChapter(chapter);
                this.showChapterList = false;
              })
            }
          })
        }
        .height(400)
        .scrollBar(BarState.Auto)
      } else {
        Column() {
          Text('ğŸ“–')
            .fontSize(48)
            .margin({ bottom: 12 })
          Text('æš‚æ— ç« èŠ‚ä¿¡æ¯')
            .fontSize(14)
            .fontColor('#718096')
        }
        .width('100%')
        .height(200)
        .justifyContent(FlexAlign.Center)
      }
    }
    .padding(20)
    .backgroundColor(Color.White)
    .borderRadius({ topLeft: 16, topRight: 16 })
  }

  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆªæ 
      this.buildHeader()
      
      // ä¸»è¦å†…å®¹åŒºåŸŸ
      if (this.isLoading) {
        // åŠ è½½ä¸­çŠ¶æ€
        Column() {
          Progress({ type: ProgressType.Ring, value: 0 })
            .width(40)
            .height(40)
            .color('#E53E3E')
          Text('æ­£åœ¨åŠ è½½ä¹¦ç±è¯¦æƒ…...')
            .fontSize(14)
            .fontColor('#718096')
            .margin({ top: 12 })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
        .backgroundColor('#F7FAFC')
      } else if (this.errorMessage) {
        // é”™è¯¯çŠ¶æ€ - æ˜¾ç¤ºä¼ é€’çš„å‚æ•°ä¿¡æ¯å’Œé”™è¯¯æç¤º
        Scroll() {
          Column() {
            // æ˜¾ç¤ºä¼ é€’çš„ä¹¦ç±ä¿¡æ¯
            this.buildDefaultBookInfo()
            
            // é”™è¯¯æç¤ºå¡ç‰‡
            Column() {
              Text('æ•°æ®åŠ è½½å¤±è´¥')
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor('#E53E3E')
                .margin({ bottom: 8 })
              
              Text(this.errorMessage)
                .fontSize(14)
                .fontColor('#4A5568')
                .textAlign(TextAlign.Center)
                .margin({ bottom: 16 })
              
              Button('é‡è¯•')
                .fontSize(14)
                .fontColor(Color.White)
                .backgroundColor('#E53E3E')
                .borderRadius(20)
                .padding({ left: 20, right: 20, top: 8, bottom: 8 })
                .onClick(() => {
                  this.loadBookDetail();
                })
            }
            .width('100%')
            .padding(20)
            .backgroundColor('#FFFFFF')
            .borderRadius(12)
            .margin({ left: 16, right: 16, top: 16 })
            .shadow({
              radius: 4,
              color: '#10000000',
              offsetY: 2
            })
            
            // åº•éƒ¨é—´è·
            Column()
              .height(80)
          }
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)
        .backgroundColor('#F7FAFC')
      } else {
        // ä¹¦ç±è¯¦æƒ…å†…å®¹
        Scroll() {
          Column() {
            // ä¹¦ç±ä¿¡æ¯å¡ç‰‡
            this.buildBookInfo()
            
            // ç®€ä»‹å¡ç‰‡
            this.buildDescription()
            
            // åº•éƒ¨é—´è·ï¼Œä¸ºåº•éƒ¨æŒ‰é’®ç•™å‡ºç©ºé—´
            Column()
              .height(80)
          }
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)
        .backgroundColor('#F7FAFC')
        
        // åº•éƒ¨æ“ä½œæŒ‰é’®
        this.buildActionButtons()
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F7FAFC')
    .bindSheet($$this.showChapterList, this.buildChapterListSheet(), {
      height: 500,
      dragBar: true,
      backgroundColor: Color.White
    })
  }
}

