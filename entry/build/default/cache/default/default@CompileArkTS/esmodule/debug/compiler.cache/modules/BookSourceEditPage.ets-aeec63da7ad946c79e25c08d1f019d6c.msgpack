          .fontSize(16)
          .backgroundColor('#F7FAFC')
          .borderRadius(8)
          .padding({ left: 12, right: 12, top: 12, bottom: 12 })
          .height(80)
          .onChange((value: string) => {
            onValueChange(value);
          })
      } else {
        TextInput({ placeholder: placeholder, text: value })
          .fontSize(16)
          .backgroundColor('#F7FAFC')
          .borderRadius(8)
          .padding({ left: 12, right: 12, top: 12, bottom: 12 })
          .onChange((value: string) => {
