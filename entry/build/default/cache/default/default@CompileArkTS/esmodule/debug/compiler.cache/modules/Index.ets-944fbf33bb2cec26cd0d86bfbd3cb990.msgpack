      TextInput({ placeholder: 'è¯·è¾“å…¥ä¹¦åã€ä½œè€…æˆ–ä¸»è§’å', text: $$this.searchKeyword })
        .fontSize(16)
        .backgroundColor('#F7FAFC')
        .borderRadius(8)
