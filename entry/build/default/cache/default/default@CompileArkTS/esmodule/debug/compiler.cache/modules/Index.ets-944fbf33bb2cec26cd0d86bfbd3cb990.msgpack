    /**
     * æ‰§è¡Œåœ¨çº¿æœç´¢
     */
    async performOnlineSearch() {
        if (this.searchKeyword.trim()) {
            hilog.info(0x0000, TAG, 'åœ¨çº¿æœç´¢å…³é”®è¯: ' + this.searchKeyword);
            this.showSearchSheet = false;
            try {
                this.isSearching = true;
                this.searchErrorMessage = '';
                // ä½¿ç”¨ä¹¦æºç®¡ç†å™¨æœç´¢å°è¯´
                const result = await bookSourceManager.searchNovels(this.searchKeyword.trim());
                if (result.success && result.data) {
                    this.onlineSearchResults = result.data;
                    this.showSearchResults = true;
                    hilog.info(0x0000, TAG, `åœ¨çº¿æœç´¢æˆåŠŸï¼Œæ‰¾åˆ° ${result.data.length} æœ¬å°è¯´`);
                }
                else {
                    this.searchErrorMessage = result.error || 'æœç´¢å¤±è´¥';
                    hilog.error(0x0000, TAG, 'åœ¨çº¿æœç´¢å¤±è´¥: ' + this.searchErrorMessage);
                }
            }
            catch (error) {
                hilog.error(0x0000, TAG, 'åœ¨çº¿æœç´¢å‡ºé”™: ' + JSON.stringify(error));
                this.searchErrorMessage = 'æœç´¢å‡ºé”™ï¼Œè¯·é‡è¯•';
            }
            finally {
                this.isSearching = false;
            }
        }
    }
    /**
     * æ‰“å¼€å°è¯´è¯¦æƒ…
     * @param novel å°è¯´ä¿¡æ¯
     */
    openNovelDetail(novel) {
        hilog.info(0x0000, TAG, 'æ‰“å¼€å°è¯´è¯¦æƒ…: ' + novel.title);
        // æž„å»ºå®Œæ•´çš„ä¹¦ç±è¯¦æƒ…URL
        const fullBookUrl = novel.link.startsWith('http') ?
            novel.link :
            'https://www.bqg128.com' + novel.link;
        hilog.info(0x0000, TAG, 'ä¹¦ç±è¯¦æƒ…é“¾æŽ¥: ' + fullBookUrl);
        // è·³è½¬åˆ°ä¹¦ç±è¯¦æƒ…é¡µé¢
        router.pushUrl({
            url: 'pages/BookDetailPage',
            params: {
                bookUrl: fullBookUrl,
                bookTitle: novel.title,
                bookAuthor: novel.author,
                bookCover: novel.cover
            }
        }).then(() => {
            hilog.info(0x0000, TAG, 'æˆåŠŸè·³è½¬åˆ°ä¹¦ç±è¯¦æƒ…é¡µé¢');
        }).catch((error) => {
            hilog.error(0x0000, TAG, 'è·³è½¬å¤±è´¥: ' + error.message);
        });
    }
    /**
     * è¿”å›žä¹¦æž¶
     */
    backToBookshelf() {
        this.showSearchResults = false;
        this.onlineSearchResults = [];
        this.searchKeyword = '';
        this.searchErrorMessage = '';
    }
    jumper(book) {
        if (!book.filePath) {
            return;
        }
        this.getUIContext().getRouter().pushUrl({
            url: "pages/Reader", params: {
                filePath: book.filePath,
                resourceIndex: book.resourceIndex,
                domPos: book.domPos || ''
            }
        });
        // Router addObserver æ–¹æ³•å·²ç§»é™¤ï¼Œå› ä¸ºRouterç±»åž‹æ²¡æœ‰è¿™ä¸ªå±žæ€§
    }
    /**
     * Remove the page transition animation to speed up the page access speed of the reader
     */
    pageTransition() {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            PageTransition.create();
        }, null);
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            PageTransitionEnter.create({ duration: 0, curve: Curve.Sharp });
        }, null);
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            PageTransitionExit.create({ duration: 0, curve: Curve.Sharp });
        }, null);
        PageTransition.pop();
    }
    rerender() {
        this.updateDirtyElements();
    }
    static getEntryName() {
        return "Index";
    }
}
