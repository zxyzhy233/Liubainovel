  build() {
    // å¦‚æžœæ˜¾ç¤ºæœç´¢ç»“æžœé¡µé¢ï¼Œåˆ™æ˜¾ç¤ºæœç´¢ç»“æžœ
    if (this.showSearchResults) {
      this.buildSearchResultsPage()
    } else {
      // å¦åˆ™æ˜¾ç¤ºä¹¦æž¶é¡µé¢
      Column() {
      Row() {
        Row({ space: 16 }) {
          Image($r('app.media.sousuo'))
            .width(32)
            .height(32)
            .onClick(() => {
              this.getUIContext().getRouter().pushUrl({ url: 'pages/SearchPage' });
            })

          Image($r('app.media.xuanx'))
            .width(32)
            .height(32)
            .onClick(() => {
              this.isShow = !this.isShow;
            })
            .bindPopup(this.isShow, {
              builder: this.popupWithButtonBuilder(),
              placement: Placement.Bottom,
              onStateChange: (e) => {
                if (!e.isVisible) {
                  this.isShow = false;
                }
              }
            })
        }
      }
      .width('100%')
      .height(56)
      .padding({ left: 16, right: 16 })
      .margin({ top: 44 })
      .justifyContent(FlexAlign.End)
      .alignItems(VerticalAlign.Center)

      if (this.isEditMode) {
        Row() {
          Text('åˆ é™¤')
            .fontColor(Color.Red)
            .onClick(async () => {
              await bookDataManager.deleteBooksByIds(this.selectedBooks);
              this.selectedBooks = [];
              this.isEditMode = false;
              await this.loadBooksFromDB();
            })
          Blank()
          Text('å–æ¶ˆ')
            .onClick(() => {
              this.selectedBooks = [];
              this.isEditMode = false;
            })
        }
        .width('100%')
        .height(56)
        .padding({ left: 16, right: 16 })
        .justifyContent(FlexAlign.SpaceBetween)
      }

      if (this.isGridView) {
        Grid() {
          ForEach(this.books, (book: BookInfo) => {
            GridItem() {
              Column({ space: 8 }) {
                Stack({ alignContent: Alignment.TopEnd }) {
                  Image(book.coverPath || $r('app.media.zwfm'))
                    .width('100%')
                    .aspectRatio(0.75)
                    .borderRadius(8)
                    .backgroundColor($r('app.color.black_5_opacity'))
                  if (this.isEditMode) {
                    Image(this.selectedBooks.includes(book.id) ? $r('app.media.CheckCircle') : $r('app.media.Circle'))
                      .width(24)
                      .height(24)
                      .margin({ top: 4, right: 4 })
                  }
                }
                Text(book.bookName)
                  .fontSize(14)
                  .maxLines(2)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
              }
              .padding(8)
              .onClick(() => {
                if (this.isEditMode) {
                  const index = this.selectedBooks.indexOf(book.id);
                  if (index > -1) {
                    this.selectedBooks.splice(index, 1);
                  } else {
                    this.selectedBooks.push(book.id);
                  }
                } else {
                  this.jumper(book);
                }
              })
            }
          })
        }
        .columnsTemplate('1fr 1fr 1fr')
        .columnsGap(16)
        .rowsGap(16)
        .layoutWeight(1)
        .padding({ top: 20 })
      } else {
        // Listå¸ƒå±€
        List({ space: 12 }) {
          ForEach(this.books, (book: BookInfo) => {
            ListItem() {
              Row({ space: 12 }) {
                Image(book.coverPath || $r('app.media.zwfm'))
                  .width(60)
                  .aspectRatio(0.75)
                  .borderRadius(4)
                  .backgroundColor($r('app.color.black_5_opacity'))
                Column({ space: 4 }) {
                  Text(book.bookName)
                    .fontSize(16)
                    .fontWeight(FontWeight.Bold)
                    .maxLines(1)
                    .textOverflow({ overflow: TextOverflow.Ellipsis })
                  Text(book.author || 'æœªçŸ¥')
                    .fontSize(14)
                    .fontColor($r('app.color.black_60_opacity'))
                    .maxLines(1)
                    .textOverflow({ overflow: TextOverflow.Ellipsis })
                  Text(`å·²è¯»: ${book.progress}`)
                    .fontSize(12)
                    .fontColor($r('app.color.black_60_opacity'))
                }
                .alignItems(HorizontalAlign.Start)
                .layoutWeight(1)
              }
              .padding({ top: 8, bottom: 8 })
              .onClick(() => {
                this.jumper(book);
              })
            }
          })
        }
        .layoutWeight(1)
        .padding({ top: 20 })
      }
    }
    .height('100%')
    .width('100%')
    .backgroundColor($r('app.color.page_background'))
    .padding({ left: 16, right: 16 })
    .bindSheet($$this.showSearchSheet, this.buildSearchSheet(), {
      height: 300,
      dragBar: true,
      backgroundColor: Color.White,
      onAppear: () => {
        hilog.info(0x0000, TAG, 'æœç´¢å¼¹çª—å‡ºçŽ°');
      },
      onDisappear: () => {
        hilog.info(0x0000, TAG, 'æœç´¢å¼¹çª—æ¶ˆå¤±');
      }
    })
    }
  }

  @Builder
  popupWithButtonBuilder() {
    Column() {
      Row({ space: 16 }) {
        Image($r("app.media.sousuo")).width(20).height(20)
        Text('åœ¨çº¿æœç´¢').fontSize(18)
