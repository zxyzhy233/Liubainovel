        throw new Error(`ä¹¦æº "${sourceName}" ä¸å­˜åœ¨`);
      }

      this.bookSources.splice(index, 1);
      this.sourceStats.delete(sourceName);
      await this.saveBookSources();
      await this.saveStats();
      
      hilog.info(0x0000, TAG, `åˆ é™¤ä¹¦æºæˆåŠŸ: ${sourceName}`);
    } catch (error) {
      hilog.error(0x0000, TAG, `åˆ é™¤ä¹¦æºå¤±è´¥: ${error}`);
      if (error instanceof Error) {
        throw error;
      } else {
        throw new Error(String(error));
      }
    }
  }

  /**
   * å¯ç”¨/ç¦ç”¨ä¹¦æº
   * @param sourceName ä¹¦æºåç§°
   * @param enabled æ˜¯å¦å¯ç”¨
   */
  async toggleBookSource(sourceName: string, enabled: boolean): Promise<void> {
    try {
      const source = this.bookSources.find(s => s.bookSourceName === sourceName);
      if (!source) {
        throw new Error(`ä¹¦æº "${sourceName}" ä¸å­˜åœ¨`);
      }

      source.enabled = enabled;
      await this.saveBookSources();
      
      hilog.info(0x0000, TAG, `${enabled ? 'å¯ç”¨' : 'ç¦ç”¨'}ä¹¦æºæˆåŠŸ: ${sourceName}`);
    } catch (error) {
      hilog.error(0x0000, TAG, `åˆ‡æ¢ä¹¦æºçŠ¶æ€å¤±è´¥: ${error}`);
      if (error instanceof Error) {
        throw error;
      } else {
        throw new Error(String(error));
      }
    }
  }

