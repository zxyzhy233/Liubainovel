  /**
   * æ‰¹é‡å¯¼å…¥ä¹¦æº
   * @param sources ä¹¦æºåˆ—è¡¨
   * @returns å¯¼å…¥ç»“æœ
   */
  async importBookSources(sources: BookSourceInfo[]): Promise<ImportResult> {
    let success = 0;
    let failed = 0;
    const errors: string[] = [];

    for (const source of sources) {
      try {
        await this.addBookSource(source);
        success++;
      } catch (error) {
        failed++;
        errors.push(`${source.bookSourceName}: ${error}`);
      }
    }

    hilog.info(0x0000, TAG, `æ‰¹é‡å¯¼å…¥å®Œæˆï¼ŒæˆåŠŸ: ${success}, å¤±è´¥: ${failed}`);
    const result: ImportResult = {
      success: success,
      failed: failed,
      errors: errors
    };
    return result;
  }

  /**
   * å¯¼å‡ºä¹¦æº
   * @param sourceNames è¦å¯¼å‡ºçš„ä¹¦æºåç§°åˆ—è¡¨ï¼Œä¸ºç©ºåˆ™å¯¼å‡ºæ‰€æœ‰
   * @returns ä¹¦æºæ•°æ®
   */
  exportBookSources(sourceNames?: string[]): BookSourceInfo[] {
    if (sourceNames && sourceNames.length > 0) {
      return this.bookSources.filter(s => sourceNames.includes(s.bookSourceName));
    }
    return this.bookSources.slice();
  }

  /**
   * æ›´æ–°ç»Ÿè®¡ä¿¡æ¯
   * @param sourceName ä¹¦æºåç§°
   * @param success æ˜¯å¦æˆåŠŸ
   * @param responseTime å“åº”æ—¶é—´
   */
  private updateStats(sourceName: string, success: boolean, responseTime: number): void {
    if (!this.config.enableStats) return;

    let stats = this.sourceStats.get(sourceName);
    if (!stats) {
      stats = {
        sourceName: sourceName,
        totalRequests: 0,
        successRequests: 0,
        failedRequests: 0,
        averageResponseTime: 0,
        lastUsedTime: 0,
        successRate: 0
      };
      this.sourceStats.set(sourceName, stats);
    }

    stats.totalRequests++;
    stats.lastUsedTime = Date.now();

    if (success) {
      stats.successRequests++;
    } else {
      stats.failedRequests++;
    }

    // æ›´æ–°å¹³å‡å“åº”æ—¶é—´
    stats.averageResponseTime = (stats.averageResponseTime * (stats.totalRequests - 1) + responseTime) / stats.totalRequests;
    
    // æ›´æ–°æˆåŠŸç‡
    stats.successRate = stats.successRequests / stats.totalRequests;

    // å¼‚æ­¥ä¿å­˜ç»Ÿè®¡æ•°æ®
    this.saveStats();
  }

  /**
   * è·å–æ¨èå°è¯´ï¼ˆä½¿ç”¨ç¬¬ä¸€ä¸ªå¯ç”¨çš„ä¹¦æºï¼‰
   * @returns Promise<ParseResult<NovelInfo[]>> è§£æç»“æœ
   */
  async getRecommendNovels(): Promise<ParseResult<NovelInfo[]>> {
    if (this.enabledSources.length === 0) {
      hilog.warn(0x0000, TAG, 'æ²¡æœ‰å¯ç”¨çš„ä¹¦æºï¼Œè¿”å›æ¨¡æ‹Ÿæ•°æ®');
      return this.getMockRecommendNovels();
    }

    for (const source of this.enabledSources) {
      try {
        const startTime = Date.now();
        const parser = new BookSourceParser(source);
        const result = await parser.parseRecommendNovels();
        const responseTime = Date.now() - startTime;
        
        this.updateStats(source.bookSourceName, result.success, responseTime);
        
        if (result.success && result.data && result.data.length > 0) {
          hilog.info(0x0000, TAG, `æˆåŠŸä»ä¹¦æº ${source.bookSourceName} è·å– ${result.data.length} æœ¬æ¨èå°è¯´`);
          return result;
        }
      } catch (error) {
        hilog.warn(0x0000, TAG, `ä¹¦æº ${source.bookSourceName} è·å–æ¨èå¤±è´¥: ${error}`);
        this.updateStats(source.bookSourceName, false, 0);
      }
    }

    hilog.warn(0x0000, TAG, 'æ‰€æœ‰ä¹¦æºéƒ½æ— æ³•è·å–æ¨èå°è¯´ï¼Œè¿”å›æ¨¡æ‹Ÿæ•°æ®');
    return this.getMockRecommendNovels();
  }

