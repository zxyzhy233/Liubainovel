    /**
     * ä½¿ç”¨æ­£åˆ™è¡¨è¾¾å¼è§£æHTMLå†…å®¹ï¼Œæå–çƒ­é—¨å°è¯´ä¿¡æ¯
     * @param html HTMLå†…å®¹
     */
    parseNovelList(html) {
        try {
            // å…ˆæ‰“å°HTMLå†…å®¹çš„ä¸€éƒ¨åˆ†ç”¨äºè°ƒè¯•
            hilog.info(0x0000, TAG, 'HTMLå†…å®¹é•¿åº¦: ' + html.length);
            // åŒ¹é… <div class="hot"> åŒºåŸŸå†…å®¹ï¼Œä½¿ç”¨æ›´ç²¾ç¡®çš„åŒ¹é…
            const hotRegex = /<div class="hot">([\s\S]*?)<\/div>\s*<div class="top">/;
            const hotMatch = hotRegex.exec(html);
            if (!hotMatch) {
                hilog.warn(0x0000, TAG, 'æœªæ‰¾åˆ°çƒ­é—¨å°è¯´åŒºåŸŸï¼Œå°è¯•å¤‡ç”¨åŒ¹é…');
                // å¤‡ç”¨åŒ¹é…æ–¹æ¡ˆ
                const hotRegexAlt = /<div class="hot">([\s\S]*?)(?=<div class="top"|$)/;
                const hotMatchAlt = hotRegexAlt.exec(html);
                if (!hotMatchAlt) {
                    this.errorMessage = 'æœªæ‰¾åˆ°çƒ­é—¨å°è¯´æ•°æ®';
                    return;
                }
                this.parseHotContent(hotMatchAlt[1]);
                return;
            }
            this.parseHotContent(hotMatch[1]);
        }
        catch (error) {
            hilog.error(0x0000, TAG, 'è§£æHTMLå¤±è´¥: ' + JSON.stringify(error));
            this.errorMessage = 'è§£ææ•°æ®å¤±è´¥';
        }
    }
    /**
     * è§£æçƒ­é—¨åŒºåŸŸå†…å®¹
     * @param hotContent çƒ­é—¨åŒºåŸŸHTMLå†…å®¹
     */
    parseHotContent(hotContent) {
        try {
            hilog.info(0x0000, TAG, 'çƒ­é—¨åŒºåŸŸå†…å®¹é•¿åº¦: ' + hotContent.length);
            const novels = [];
            // ä½¿ç”¨æ›´ç²¾ç¡®çš„æ­£åˆ™è¡¨è¾¾å¼åŒ¹é…å®Œæ•´çš„itemç»“æ„
            const itemRegex = /<div class="item">[\s\S]*?<div class="image">[\s\S]*?<\/div>[\s\S]*?<dl>[\s\S]*?<\/dl>[\s\S]*?<\/div>/g;
            let itemMatch;
            let count = 0;
            while ((itemMatch = itemRegex.exec(hotContent)) !== null && count < 4) {
                const itemContent = itemMatch[0]; // ä½¿ç”¨å®Œæ•´åŒ¹é…å†…å®¹
                hilog.info(0x0000, TAG, `è§£æç¬¬${count + 1}ä¸ªitemï¼Œå†…å®¹é•¿åº¦: ${itemContent.length}`);
                // æå–å°é¢å›¾ç‰‡
                const coverRegex = /<img[^>]+src="([^"]+)"[^>]*>/;
                const coverMatch = coverRegex.exec(itemContent);
                const cover = coverMatch ? coverMatch[1] : '';
                // æå–å°è¯´æ ‡é¢˜å’Œé“¾æ¥
                const titleRegex = /<a[^>]+href="([^"]+)"[^>]*>([^<]+)<\/a>/g;
                let titleMatch;
                let link = '';
                let title = '';
                // æ‰¾åˆ°dtæ ‡ç­¾å†…çš„aæ ‡ç­¾ï¼ˆç¬¬äºŒä¸ªaæ ‡ç­¾é€šå¸¸æ˜¯æ ‡é¢˜ï¼‰
                let matchCount = 0;
                while ((titleMatch = titleRegex.exec(itemContent)) !== null) {
                    matchCount++;
                    if (matchCount === 2) { // ç¬¬äºŒä¸ªaæ ‡ç­¾æ˜¯æ ‡é¢˜
                        link = titleMatch[1];
                        title = titleMatch[2].trim();
                        break;
                    }
                }
                // å¦‚æœæ²¡æ‰¾åˆ°ç¬¬äºŒä¸ªaæ ‡ç­¾ï¼Œä½¿ç”¨ç¬¬ä¸€ä¸ª
                if (!title && !link) {
                    titleRegex.lastIndex = 0; // é‡ç½®æ­£åˆ™è¡¨è¾¾å¼
                    titleMatch = titleRegex.exec(itemContent);
                    if (titleMatch) {
                        link = titleMatch[1];
                        title = titleMatch[2].trim();
                    }
                }
                // æå–ä½œè€…
                const authorRegex = /<span[^>]*>([^<]+)<\/span>/;
                const authorMatch = authorRegex.exec(itemContent);
                const author = authorMatch ? authorMatch[1].trim() : 'æœªçŸ¥ä½œè€…';
                // æå–ç®€ä»‹
                const descRegex = /<dd[^>]*>([^<]+)<\/dd>/;
                const descMatch = descRegex.exec(itemContent);
                const description = descMatch ? descMatch[1].trim() : 'æš‚æ— ç®€ä»‹';
                hilog.info(0x0000, TAG, `è§£æç»“æœ - æ ‡é¢˜: ${title}, ä½œè€…: ${author}, é“¾æ¥: ${link}`);
                if (title && link) {
                    novels.push({
                        cover: cover.startsWith('http') ? cover : 'https://www.bqg128.com' + cover,
                        title: title,
                        author: author,
                        description: description,
                        link: link.startsWith('http') ? link : 'https://www.bqg128.com' + link
                    });
                    count++;
                }
            }
            this.novelList = novels.slice(0, 4); // åªå–4æœ¬å°è¯´
            hilog.info(0x0000, TAG, 'æˆåŠŸè§£æ ' + this.novelList.length + ' æœ¬çƒ­é—¨å°è¯´');
            // æ‰“å°è§£æç»“æœç”¨äºè°ƒè¯•
            this.novelList.forEach((novel, index) => {
                hilog.info(0x0000, TAG, `å°è¯´${index + 1}: ${novel.title} - ${novel.author}`);
            });
        }
        catch (error) {
            hilog.error(0x0000, TAG, 'è§£æçƒ­é—¨å†…å®¹å¤±è´¥: ' + JSON.stringify(error));
            this.errorMessage = 'è§£ææ•°æ®å¤±è´¥';
        }
    }
