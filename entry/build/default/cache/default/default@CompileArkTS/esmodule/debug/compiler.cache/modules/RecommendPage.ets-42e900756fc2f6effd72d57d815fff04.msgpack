import { http } from '@kit.NetworkKit';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { common, Want } from '@kit.AbilityKit';

const TAG: string = 'RecommendPage';

/**
 * å°è¯´ä¿¡æ¯æ¥å£
 */
interface NovelInfo {
  cover: string; // å°é¢å›¾ç‰‡URL
  title: string; // å°è¯´æ ‡é¢˜
  author: string; // ä½œè€…
  description: string; // ç®€ä»‹
  link: string; // è¯¦æƒ…é“¾æ¥
}

@Entry
@Component
struct RecommendPage {
  @State novelList: NovelInfo[] = []; // å°è¯´åˆ—è¡¨
  @State currentIndex: number = 0; // å½“å‰è½®æ’­å›¾ç´¢å¼•
  @State isLoading: boolean = true; // åŠ è½½çŠ¶æ€
  @State errorMessage: string = ''; // é”™è¯¯ä¿¡æ¯

  /**
   * é¡µé¢æ˜¾ç¤ºæ—¶åŠ è½½æ¨èå°è¯´
   */
  async aboutToAppear() {
    await this.loadRecommendNovels();
  }

  /**
   * ä»ç¬”è¶£é˜ç½‘ç«™åŠ è½½æ¨èå°è¯´
   */
  private async loadRecommendNovels() {
    try {
      this.isLoading = true;
      this.errorMessage = '';
      
      // åˆ›å»ºHTTPè¯·æ±‚
      let httpRequest = http.createHttp();
      let response = await httpRequest.request(
        'https://www.bqg128.com/',
        {
          method: http.RequestMethod.GET,
          header: {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
          }
        }
      );

      if (response.responseCode === 200) {
        const htmlContent = response.result.toString();
        this.parseNovelList(htmlContent);
      } else {
        hilog.error(0x0000, TAG, 'HTTPè¯·æ±‚å¤±è´¥: ' + response.responseCode);
        this.errorMessage = 'ç½‘ç»œè¯·æ±‚å¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè¿æ¥';
      }
    } catch (error) {
      hilog.error(0x0000, TAG, 'åŠ è½½æ¨èå°è¯´å¤±è´¥: ' + JSON.stringify(error));
      this.errorMessage = 'åŠ è½½å¤±è´¥ï¼Œè¯·é‡è¯•';
    } finally {
      this.isLoading = false;
    }
  }

  /**
   * ä½¿ç”¨æ­£åˆ™è¡¨è¾¾å¼è§£æHTMLå†…å®¹ï¼Œæå–çƒ­é—¨å°è¯´ä¿¡æ¯
   * @param html HTMLå†…å®¹
   */
  private parseNovelList(html: string) {
    try {
      // å…ˆæ‰“å°HTMLå†…å®¹çš„ä¸€éƒ¨åˆ†ç”¨äºè°ƒè¯•
      hilog.info(0x0000, TAG, 'HTMLå†…å®¹é•¿åº¦: ' + html.length);
      
      // åŒ¹é… <div class="hot"> åŒºåŸŸå†…å®¹ï¼Œä½¿ç”¨æ›´ç²¾ç¡®çš„åŒ¹é…
      const hotRegex = /<div class="hot">([\s\S]*?)<\/div>\s*<div class="top">/;
      const hotMatch = hotRegex.exec(html);
      
      if (!hotMatch) {
        hilog.warn(0x0000, TAG, 'æœªæ‰¾åˆ°çƒ­é—¨å°è¯´åŒºåŸŸï¼Œå°è¯•å¤‡ç”¨åŒ¹é…');
        // å¤‡ç”¨åŒ¹é…æ–¹æ¡ˆ
        const hotRegexAlt = /<div class="hot">([\s\S]*?)(?=<div class="top"|$)/;
        const hotMatchAlt = hotRegexAlt.exec(html);
        if (!hotMatchAlt) {
          this.errorMessage = 'æœªæ‰¾åˆ°çƒ­é—¨å°è¯´æ•°æ®';
          return;
        }
        this.parseHotContent(hotMatchAlt[1]);
        return;
      }

      this.parseHotContent(hotMatch[1]);
      
    } catch (error) {
      hilog.error(0x0000, TAG, 'è§£æHTMLå¤±è´¥: ' + JSON.stringify(error));
      this.errorMessage = 'è§£ææ•°æ®å¤±è´¥';
    }
  }

  /**
   * è§£æçƒ­é—¨åŒºåŸŸå†…å®¹
   * @param hotContent çƒ­é—¨åŒºåŸŸHTMLå†…å®¹
   */
  private parseHotContent(hotContent: string) {
    try {
      hilog.info(0x0000, TAG, 'çƒ­é—¨åŒºåŸŸå†…å®¹é•¿åº¦: ' + hotContent.length);
      
      const novels: NovelInfo[] = [];

      // ä½¿ç”¨æ›´ç²¾ç¡®çš„æ­£åˆ™è¡¨è¾¾å¼åŒ¹é…å®Œæ•´çš„itemç»“æ„
      const itemRegex = /<div class="item">[\s\S]*?<div class="image">[\s\S]*?<\/div>[\s\S]*?<dl>[\s\S]*?<\/dl>[\s\S]*?<\/div>/g;
      let itemMatch: RegExpExecArray | null;
      let count = 0;

      while ((itemMatch = itemRegex.exec(hotContent)) !== null && count < 4) {
        const itemContent = itemMatch[0]; // ä½¿ç”¨å®Œæ•´åŒ¹é…å†…å®¹
        
        hilog.info(0x0000, TAG, `è§£æç¬¬${count + 1}ä¸ªitemï¼Œå†…å®¹é•¿åº¦: ${itemContent.length}`);
        
        // æå–å°é¢å›¾ç‰‡
        const coverRegex = /<img[^>]+src="([^"]+)"[^>]*>/;
        const coverMatch = coverRegex.exec(itemContent);
        const cover = coverMatch ? coverMatch[1] : '';
        
        // æå–å°è¯´æ ‡é¢˜å’Œé“¾æ¥
        const titleRegex = /<a[^>]+href="([^"]+)"[^>]*>([^<]+)<\/a>/g;
        let titleMatch: RegExpExecArray | null;
        let link = '';
        let title = '';
        
        // æ‰¾åˆ°dtæ ‡ç­¾å†…çš„aæ ‡ç­¾ï¼ˆç¬¬äºŒä¸ªaæ ‡ç­¾é€šå¸¸æ˜¯æ ‡é¢˜ï¼‰
        let matchCount = 0;
        while ((titleMatch = titleRegex.exec(itemContent)) !== null) {
          matchCount++;
          if (matchCount === 2) { // ç¬¬äºŒä¸ªaæ ‡ç­¾æ˜¯æ ‡é¢˜
            link = titleMatch[1];
            title = titleMatch[2].trim();
            break;
          }
        }
        
        // å¦‚æœæ²¡æ‰¾åˆ°ç¬¬äºŒä¸ªaæ ‡ç­¾ï¼Œä½¿ç”¨ç¬¬ä¸€ä¸ª
        if (!title && !link) {
          titleRegex.lastIndex = 0; // é‡ç½®æ­£åˆ™è¡¨è¾¾å¼
          titleMatch = titleRegex.exec(itemContent);
          if (titleMatch) {
            link = titleMatch[1];
            title = titleMatch[2].trim();
          }
        }
        
        // æå–ä½œè€…
        const authorRegex = /<span[^>]*>([^<]+)<\/span>/;
        const authorMatch = authorRegex.exec(itemContent);
        const author = authorMatch ? authorMatch[1].trim() : 'æœªçŸ¥ä½œè€…';
        
        // æå–ç®€ä»‹
        const descRegex = /<dd[^>]*>([^<]+)<\/dd>/;
        const descMatch = descRegex.exec(itemContent);
        const description = descMatch ? descMatch[1].trim() : 'æš‚æ— ç®€ä»‹';

        hilog.info(0x0000, TAG, `è§£æç»“æœ - æ ‡é¢˜: ${title}, ä½œè€…: ${author}, é“¾æ¥: ${link}`);

        if (title && link) {
          novels.push({
            cover: cover.startsWith('http') ? cover : 'https://www.bqg128.com' + cover,
            title: title,
            author: author,
            description: description,
            link: link.startsWith('http') ? link : 'https://www.bqg128.com' + link
          } as NovelInfo);
          count++;
        }
      }

      this.novelList = novels.slice(0, 4); // åªå–4æœ¬å°è¯´
      hilog.info(0x0000, TAG, 'æˆåŠŸè§£æ ' + this.novelList.length + ' æœ¬çƒ­é—¨å°è¯´');
      
      // æ‰“å°è§£æç»“æœç”¨äºè°ƒè¯•
      this.novelList.forEach((novel, index) => {
        hilog.info(0x0000, TAG, `å°è¯´${index + 1}: ${novel.title} - ${novel.author}`);
      });
      
    } catch (error) {
      hilog.error(0x0000, TAG, 'è§£æçƒ­é—¨å†…å®¹å¤±è´¥: ' + JSON.stringify(error));
      this.errorMessage = 'è§£ææ•°æ®å¤±è´¥';
    }
  }

  /**
   * æ„å»ºè½®æ’­å›¾ç»„ä»¶
   */
  @Builder
  private buildCarousel() {
    if (this.novelList.length === 0) {
      Column() {
        Text('æš‚æ— æ•°æ®')
      }
    } else {
      Column() {
        // è½®æ’­å›¾æŒ‡ç¤ºå™¨
        Row() {
          ForEach(this.novelList, (item: NovelInfo, index: number) => {
            Circle({ width: 8, height: 8 })
              .fill(index === this.currentIndex ? '#FF0000' : '#808080')
              .margin({ right: 4 })
          })
        }
        .justifyContent(FlexAlign.Center)
        .margin({ bottom: 16 })

        // è½®æ’­å›¾å†…å®¹
        Stack({ alignContent: Alignment.Bottom }) {
          // å°è¯´å°é¢
          Image(this.novelList[this.currentIndex].cover)
            .width('100%')
            .height(480)
            .objectFit(ImageFit.Cover)
            .borderRadius(12)

          // å°è¯´ä¿¡æ¯é®ç½© - ä¸å°é¢åº•éƒ¨å¯¹é½
          Column() {
            Text(this.novelList[this.currentIndex].title)
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
              .margin({ bottom: 8 })
              .maxLines(1)
              .textOverflow({ overflow: TextOverflow.Ellipsis })

            Text('ä½œè€…: ' + this.novelList[this.currentIndex].author)
              .fontSize(14)
              .fontColor('#FFFFFF')
              .margin({ bottom: 8 })
              .opacity(0.9)

            Text(this.novelList[this.currentIndex].description)
              .fontSize(12)
              .fontColor('#FFFFFF')
              .maxLines(2)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
              .opacity(0.8)
          }
          .padding(16)
          .width('100%')
          .align(Alignment.Top)
          .backgroundColor('#80000000') // åŠé€æ˜é»‘è‰²èƒŒæ™¯
          .alignSelf(ItemAlign.End) // ä¸Stackåº•éƒ¨å¯¹é½
          .borderRadius({ bottomLeft: 12, bottomRight: 12 }) // ä¸å°é¢åº•éƒ¨åœ†è§’ä¿æŒä¸€è‡´
        }
        .height(480) // ä¸å°é¢é«˜åº¦ä¸€è‡´
        .width('90%')
        .onClick(() => {
          // ç‚¹å‡»è·³è½¬åˆ°å°è¯´è¯¦æƒ…
          this.openNovelDetail(this.novelList[this.currentIndex]);
        })

        // å·¦å³åˆ‡æ¢æŒ‰é’® - ç§»åŠ¨åˆ°å›¾ç‰‡ä¸‹æ–¹ï¼Œå¢åŠ é—´è·
        Row() {
          Button('â†')
            .onClick(() => {
              this.prevNovel();
            })
            .backgroundColor('#E0E0E0')
            .fontColor('#333333')
            .borderRadius(8)
            .width(50)
            .height(40)

          Blank() // ä½¿ç”¨Blankç»„ä»¶å¡«å……ä¸­é—´ç©ºé—´ï¼Œè®©æŒ‰é’®åˆ†å¸ƒåœ¨ä¸¤ç«¯

          Button('â†’')
            .onClick(() => {
              this.nextNovel();
            })
            .backgroundColor('#E0E0E0')
            .fontColor('#333333')
            .borderRadius(8)
            .width(50)
            .height(40)
        }
        .width('90%')
        .justifyContent(FlexAlign.SpaceBetween) // ä¸¤ç«¯å¯¹é½ï¼Œæœ€å¤§åŒ–é—´è·
        .margin({ top: 16 })

        // åˆ·æ–°æŒ‰é’® - ç§»åŠ¨åˆ°å›¾ç‰‡ä¸‹æ–¹
        Button('åˆ·æ–°æ¨è')
          .onClick(() => {
            this.loadRecommendNovels();
          })
          .margin({ top: 16 })
          .backgroundColor('#007AFF')
          .fontColor('#FFFFFF')
          .borderRadius(8)
          .width(120)
          .height(40)
      }
    }
  }

  /**
   * åˆ‡æ¢åˆ°ä¸Šä¸€æœ¬å°è¯´
   */
  private prevNovel() {
    this.currentIndex = (this.currentIndex - 1 + this.novelList.length) % this.novelList.length;
  }

  /**
   * åˆ‡æ¢åˆ°ä¸‹ä¸€æœ¬å°è¯´
   */
  private nextNovel() {
    this.currentIndex = (this.currentIndex + 1) % this.novelList.length;
  }

  /**
   * æ‰“å¼€å°è¯´è¯¦æƒ…
   * @param novel å°è¯´ä¿¡æ¯
   */
  private async openNovelDetail(novel: NovelInfo) {
    try {
      hilog.info(0x0000, TAG, 'å‡†å¤‡æ‰“å¼€å°è¯´è¯¦æƒ…: ' + novel.title + ', é“¾æ¥: ' + novel.link);
      
      // è·å–åº”ç”¨ä¸Šä¸‹æ–‡
      const context = getContext(this) as common.UIAbilityContext;
      
      // åˆ›å»ºIntentï¼Œä½¿ç”¨ç³»ç»Ÿæµè§ˆå™¨æ‰“å¼€å°è¯´è¯¦æƒ…é¡µé¢
      const wantInfo: Want = {
        action: 'ohos.want.action.viewData',
        entities: ['entity.system.browsable'],
        uri: novel.link
      };
      
      // å¯åŠ¨æµè§ˆå™¨
      await context.startAbility(wantInfo);
      hilog.info(0x0000, TAG, 'æˆåŠŸæ‰“å¼€å°è¯´è¯¦æƒ…é¡µé¢');
      
    } catch (error) {
      hilog.error(0x0000, TAG, 'æ‰“å¼€å°è¯´è¯¦æƒ…å¤±è´¥: ' + JSON.stringify(error));
      
      // å¦‚æœç³»ç»Ÿæµè§ˆå™¨æ‰“å¼€å¤±è´¥ï¼Œå°è¯•æ˜¾ç¤ºæç¤ºä¿¡æ¯
      this.errorMessage = 'æ— æ³•æ‰“å¼€æµè§ˆå™¨ï¼Œè¯·æ£€æŸ¥ç³»ç»Ÿè®¾ç½®';
      setTimeout(() => {
        this.errorMessage = '';
      }, 3000);
    }
  }

  build() {
    Column() {
      // æ ‡é¢˜
      Text('å°è¯´æ¨è')
        .fontSize(24)
        .fontWeight(FontWeight.Bold)
        .margin({ top: 20, bottom: 20 })

      if (this.isLoading) {
        // åŠ è½½ä¸­çŠ¶æ€
        Column() {
          Progress({ value: 0, total: 100, type: ProgressType.Ring })
            .width(40)
            .height(40)
          Text('æ­£åœ¨åŠ è½½æ¨èå°è¯´...')
            .margin({ top: 16 })
        }
      } else if (this.errorMessage) {
        // é”™è¯¯çŠ¶æ€
        Text(this.errorMessage)
          .fontColor('#FF0000')
          .margin({ bottom: 16 })
        Button('é‡è¯•')
          .onClick(() => {
            this.loadRecommendNovels();
          })
      } else if (this.novelList.length === 0) {
        // ç©ºçŠ¶æ€
        Column() {
          Text('æš‚æ— æ¨èå°è¯´')
            .fontSize(16)
            .fontColor('#808080')
