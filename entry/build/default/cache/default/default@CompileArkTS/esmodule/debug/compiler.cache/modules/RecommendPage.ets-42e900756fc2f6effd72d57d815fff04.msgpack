            }
            else {
                hilog.error(0x0000, TAG, 'HTTPè¯·æ±‚å¤±è´¥: ' + response.responseCode);
                this.errorMessage = 'ç½‘ç»œè¯·æ±‚å¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œè¿æ¥';
            }
        }
        catch (error) {
            hilog.error(0x0000, TAG, 'åŠ è½½æ¨èå°è¯´å¤±è´¥: ' + JSON.stringify(error));
            this.errorMessage = 'åŠ è½½å¤±è´¥ï¼Œè¯·é‡è¯•';
        }
