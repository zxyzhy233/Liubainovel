[
  {
    "bookSourceName": "笔趣阁HK(CSS)",
    "bookSourceUrl": "https://www.biquge.hk",
    "bookSourceGroup": "默认",
    "bookSourceComment": "笔趣阁HK站源 - CSS选择器版本，更稳定易维护",
    "bookSourceType": 0,
    "enabled": true,
    "enabledCookieJar": true,
    "enabledExplore": true,
    "enabledReview": false,
    "header": "",
    "searchUrl": "https://www.biquge.hk/search/result.html?searchkey={{key}}",
    "exploreUrl": "https://www.biquge.hk",
    "bookUrlPattern": "",
    "weight": 100,
    "customOrder": 1,
    "ruleSearch": {
      "bookList": ".novellist .item",
      "name": "dt a@text",
      "author": "dd a@text",
      "bookUrl": "dt a@href",
      "coverUrl": "img@src",
      "intro": "dd.intro@text",
      "lastChapter": "",
      "kind": ""
    },
    "ruleExplore": {
      "bookList": ".novellist .item",
      "name": "dt a@text",
      "author": "dd a@text",
      "bookUrl": "dt a@href",
      "coverUrl": "img@src",
      "intro": "dd.intro@text"
    },
    "ruleBookInfo": {
      "name": "meta[property='og:novel:book_name']@content",
      "author": "meta[property='og:novel:author']@content",
      "coverUrl": "meta[property='og:image']@content",
      "intro": "meta[property='og:description']@content",
      "kind": "meta[property='og:novel:category']@content",
      "lastChapter": "meta[property='og:novel:latest_chapter_name']@content",
      "updateTime": "meta[property='og:novel:update_time']@content",
      "status": "meta[property='og:novel:status']@content",
      "tocUrl": ""
    },
    "ruleToc": {
      "chapterList": "ul.dirlist li",
      "chapterName": "a@text",
      "chapterUrl": "a@href"
    },
    "ruleContent": {
      "content": "#chaptercontent",
      "replaceRegex": "笔趣阁##||www\\.biquge\\.hk##||请收藏本站.*?<br />##||最⊥新⊥小⊥说.*?<br />##"
    },
    "ruleReview": {}
  }
]
